  openclaw-tui [command] [options]

{BOLD}Interactive Mode:{RESET}
  Simply run the tool without arguments to access the interactive Terminal User Interface:
  {CYAN}openclaw-tui{RESET}

{BOLD}Non-Interactive Commands:{RESET}
  {GREEN}status{RESET}                 Show diagnostic status of both OpenClaw AI and Captain Claw.
  {GREEN}install [ai|game]{RESET}      Install specified components.
  {GREEN}configure [ai|game]{RESET}    Configure settings for specified components.
  {GREEN}run [ai|game]{RESET}          Execute or start specified components.
  {GREEN}help, -h, --help{RESET}       Show this detailed documentation.

{BOLD}Examples:{RESET}
  openclaw-tui status
  openclaw-tui install ai
  openclaw-tui run game
""")

def run_cli_mode():
    cmd = sys.argv[1].lower()

    if cmd in ["-h", "--help", "help"]:
        print_help()
        sys.exit(0)

    elif cmd == "status":
        display_unified_status(interactive=False)
        sys.exit(0)

    elif cmd == "install":
        target = sys.argv[2].lower() if len(sys.argv) > 2 else ""
        if target == "ai":
            install_openclaw_ai()
        elif target == "game":
            install_openclaw_game()
        else:
            print_error("Please specify target: 'openclaw-tui install ai' or 'openclaw-tui install game'")
            sys.exit(1)

    elif cmd == "configure":
        target = sys.argv[2].lower() if len(sys.argv) > 2 else ""
        if target == "ai":
            configure_openclaw_ai()
        elif target == "game":
            configure_openclaw_game()
        else:
            print_error("Please specify target: 'openclaw-tui configure ai' or 'openclaw-tui configure game'")
            sys.exit(1)

    elif cmd == "run":
        target = sys.argv[2].lower() if len(sys.argv) > 2 else ""
        if target == "ai":
            launch_ai_chat()
        elif target == "game":
            run_openclaw_game()
        else:
            print_error("Please specify target: 'openclaw-tui run ai' or 'openclaw-tui run game'")
            sys.exit(1)

    else:
        print_error(f"Unknown command '{cmd}'. Use 'openclaw-tui --help' for options.")
        sys.exit(1)


