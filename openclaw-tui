# --- Subprocess Safe Execution Wrapper ---
def run_cmd(args, capture_output=False, shell=False, cwd=None):
    """
    Safely executes system commands using standard list format.
    Prevents shell=True injection issues and provides clean messaging.
    """
    try:
        if capture_output:
            res = subprocess.run(args, capture_output=True, text=True, shell=shell, cwd=cwd)
            return res.returncode, res.stdout, res.stderr
        else:
            res = subprocess.run(args, shell=shell, cwd=cwd)
            return res.returncode, "", ""
    except FileNotFoundError:
        return -1, "", "Executable not found."
    except Exception as e:
        return -1, "", str(e)


# ==========================================
# OPENCLAW AI ASSISTANT FUNCTIONS
# ==========================================

def get_node_status():
    code, stdout, _ = run_cmd(["node", "--version"], capture_output=True)
    if code == 0:
        return stdout.strip()
    return None

def check_openclaw_ai_status():
    # Check if openclaw CLI is available
    code, stdout, _ = run_cmd(["which", "openclaw"], capture_output=True)
    if code != 0:
        # Check standard global npm path or local prefix
        code, stdout, _ = run_cmd(["openclaw", "gateway", "status"], capture_output=True)
        if code == -1:
            return "Not Installed", None

    # Run status check
    code, stdout, stderr = run_cmd(["openclaw", "gateway", "status"], capture_output=True)
    if code == 0:
        return "Installed & Running", stdout.strip()
    else:
        return "Installed (Gateway Stopped)", stderr.strip() if stderr else stdout.strip()

def install_openclaw_ai():
    print_header("Installing OpenClaw AI Assistant")

    node_ver = get_node_status()
    if not node_ver:
        print_warning("Node.js was not detected on this system. Node.js 22.22.3+ is required.")
        install_node_opt = get_input("Do you want this installer to try provisioning Node.js? (y/n)", "y")
        if install_node_opt.lower() != 'y':
            print_error("Aborting installation. Please install Node.js and try again.")
            return False
    else:
        print_success(f"Detected Node.js version: {node_ver}")

    print_info("Choose installation method:")
    print("1) Recommended: Official Installer script (curl)")
    print("2) Global npm package (npm install -g openclaw)")
    print("3) Build/Run from source code (git clone + pnpm)")
    method = get_input("Select option (1-3)", "1")

    if method == "1":
        print_info("Executing official install.sh...")
        # curl -fsSL https://openclaw.ai/install.sh | bash
        # To avoid shell=True, we download the script first, then execute it via bash
        try:
            print_info("Downloading install script...")
            script_url = "https://openclaw.ai/install.sh"
            with urllib.request.urlopen(script_url) as response:
                script_content = response.read().decode('utf-8')

            # Save temporary script
            temp_script = "/tmp/openclaw_install.sh"
            with open(temp_script, "w") as f:
                f.write(script_content)

            print_info("Running install.sh via bash...")
            code, _, _ = run_cmd(["bash", temp_script])
            if code == 0:
                print_success("Official OpenClaw AI installer script executed successfully!")
                return True
            else:
                print_error(f"Installation script failed with exit code: {code}")
        except Exception as e:
            print_error(f"Failed to fetch/execute installer: {e}")
            print_info("Falling back to piping command via shell (use with caution)...")
            code, _, _ = run_cmd("curl -fsSL https://openclaw.ai/install.sh | bash", shell=True)
            if code == 0:
                print_success("Installation succeeded via fallback script.")
                return True

    elif method == "2":
        print_info("Installing globally via npm...")
        code, _, _ = run_cmd(["npm", "install", "-g", "openclaw@latest"])
        if code == 0:
            print_success("OpenClaw globally installed via npm!")
            print_info("Initializing onboarding...")
            run_cmd(["openclaw", "onboard", "--install-daemon"])
            return True
        else:
            print_error("npm installation failed. Make sure you have proper write permissions (sudo).")

    elif method == "3":
        print_info("Cloning source repo...")
        dest = get_input("Destination folder for git checkout", os.path.expanduser("~/openclaw-ai"))
        if os.path.exists(dest):
            print_warning(f"Directory {dest} already exists.")
            cont = get_input("Overwrite or pull latest inside? (y/n)", "y")
            if cont.lower() != 'y':
                return False

        if not os.path.exists(dest):
            code, _, _ = run_cmd(["git", "clone", "https://github.com/openclaw/openclaw.git", dest])
        else:
            code, _, _ = run_cmd(["git", "pull"], cwd=dest)

        if code == 0:
            print_success("Repository downloaded successfully!")
            print_info("Installing dependencies with pnpm...")
            code, _, _ = run_cmd(["corepack", "enable"], cwd=dest)
            code, _, _ = run_cmd(["pnpm", "install"], cwd=dest)
            if code == 0:
                print_success("Source build setup finished! Run onboarding using 'pnpm openclaw onboard'.")
                return True
            else:
                print_error("Failed to install package dependencies via pnpm.")
        else:
            print_error("Git operation failed.")

    return False

def configure_openclaw_ai():
    print_header("Configure OpenClaw AI Assistant")
    config_path = os.path.expanduser("~/.openclaw/openclaw.json")

    if os.path.exists(config_path):
        print_success(f"Found active configuration at: {config_path}")
        print_info("Choose configuration option:")
        print("1) Launch Onboarding Wizard (openclaw onboard)")
        print("2) Modify settings via interactive editor (openclaw configure)")
        print("3) View raw JSON configuration")
        print("4) Edit config manually using terminal editor")
        opt = get_input("Select (1-4)", "1")

        if opt == "1":
            run_cmd(["openclaw", "onboard"])
        elif opt == "2":
            run_cmd(["openclaw", "configure"])
        elif opt == "3":
            try:
                with open(config_path, "r") as f:
                    data = json.load(f)
                print(json.dumps(data, indent=2))
                get_input("Press ENTER to return")
            except Exception as e:
                print_error(f"Could not read config file: {e}")
        elif opt == "4":
            editor = os.environ.get("EDITOR", "nano")
            print_info(f"Opening config in {editor}...")
            run_cmd([editor, config_path])
    else:
        print_warning("No existing openclaw.json detected.")
        start_onboard = get_input("Would you like to start the Guided Onboarding wizard now? (y/n)", "y")
        if start_onboard.lower() == 'y':
            run_cmd(["openclaw", "onboard"])

def run_openclaw_ai_daemon(action):
    """
    Action: start, stop, restart, status
    """
    print_header(f"Gateway Daemon Control: {action.upper()}")
    code, stdout, stderr = run_cmd(["openclaw", "gateway", action])
    if code == 0:
        print_success(f"Gateway daemon {action}ed successfully!")
        if stdout:
            print(stdout)
    else:
        print_error(f"Failed to execute gateway command: {stderr or stdout}")
    get_input("Press ENTER to continue")

def launch_ai_chat():
    print_header("Launching OpenClaw Chat Terminal (TUI)")
    print_info("Starting localized terminal session...")
    run_cmd(["openclaw", "tui"])

def launch_ai_dashboard():
    print_header("Opening Control UI Dashboard")
    print_info("Opening OpenClaw dashboard in your default browser...")
    run_cmd(["openclaw", "dashboard"])

def run_ai_doctor():
    print_header("OpenClaw Diagnostics (Doctor)")
    run_cmd(["openclaw", "doctor"])
    get_input("\nPress ENTER to return to menu")


# ==========================================
# DIAGNOSTICS & SYSTEM STATUS
# ==========================================

def display_unified_status(interactive=True):
    print_header("OpenClaw System Diagnostics")

    # 1. OS & Platform Details
    print(f"{BOLD}System Information:{RESET}")
    print(f"  OS Platform:   {platform.system()} {platform.release()}")
    print(f"  Architecture:  {platform.machine()}")

    # 2. Node.js Status
    node_ver = get_node_status()
    node_disp = f"{GREEN}Installed ({node_ver}){RESET}" if node_ver else f"{RED}Missing{RESET}"
    print(f"  Node.js:       {node_disp}")

    # 3. OpenClaw AI Status
    ai_status, extra = check_openclaw_ai_status()
    if "Running" in ai_status:
        ai_disp = f"{GREEN}{ai_status}{RESET}"
    elif "Stopped" in ai_status:
        ai_disp = f"{YELLOW}{ai_status}{RESET}"
    else:
        ai_disp = f"{RED}{ai_status}{RESET}"
    print(f"  AI Assistant:  {ai_disp}")
    if extra:
        print(f"    ↳ Info: {extra}")

    if interactive:
        get_input("\nPress ENTER to return to menu")


# ==========================================
# CLI MODE (ARGUMENT PARSER)
# ==========================================

def print_help():
    show_logo()
    print(f"""{BOLD}Usage:{RESET}
  openclaw-tui [command] [options]

{BOLD}Interactive Mode:{RESET}
  Simply run the tool without arguments to access the interactive Terminal User Interface:
  {CYAN}openclaw-tui{RESET}

{BOLD}Non-Interactive Commands:{RESET}
  {GREEN}status{RESET}                 Show diagnostic status of OpenClaw AI.
  {GREEN}install{RESET}                Install OpenClaw AI Assistant.
  {GREEN}configure{RESET}              Configure settings for OpenClaw AI Assistant.
  {GREEN}run{RESET}                    Execute or start OpenClaw AI Assistant.
  {GREEN}help, -h, --help{RESET}       Show this detailed documentation.

{BOLD}Examples:{RESET}
  openclaw-tui status
  openclaw-tui install
  openclaw-tui run
""")

def run_cli_mode():
    cmd = sys.argv[1].lower()

    if cmd in ["-h", "--help", "help"]:
        print_help()
        sys.exit(0)

    elif cmd == "status":
        display_unified_status(interactive=False)
        sys.exit(0)

    elif cmd == "install":
        target = sys.argv[2].lower() if len(sys.argv) > 2 else ""
        if target in ["", "ai"]:
            install_openclaw_ai()
        else:
            print_error(f"Unknown target '{target}' for install command.")
            sys.exit(1)

    elif cmd == "configure":
        target = sys.argv[2].lower() if len(sys.argv) > 2 else ""
        if target in ["", "ai"]:
            configure_openclaw_ai()
        else:
            print_error(f"Unknown target '{target}' for configure command.")
            sys.exit(1)

    elif cmd == "run":
        target = sys.argv[2].lower() if len(sys.argv) > 2 else ""
        if target in ["", "ai"]:
            launch_ai_chat()
        else:
            print_error(f"Unknown target '{target}' for run command.")
            sys.exit(1)

    else:
        print_error(f"Unknown command '{cmd}'. Use 'openclaw-tui --help' for options.")
        sys.exit(1)


# ==========================================
# INTERACTIVE TLI MAIN MENU LOOP
# ==========================================

def run_interactive_mode():
    while True:
        clear_screen()
        show_logo()

        print_header("OpenClaw AI Assistant Control Panel")
        print("1) 📥 Install / Download")
        print("2) ⚙️ Configure Onboarding (openclaw onboard)")
        print("3) 🚀 Start Gateway Daemon")
        print("4) 🛑 Stop Gateway Daemon")
        print("5) 🔄 Restart Gateway Daemon")
        print("6) 💬 Launch Local Chat (TUI)")
        print("7) 📊 Open Browser Dashboard")
        print("8) 🩺 Run Doctor Diagnostics")
        print("9) 📋 System Diagnostics (OS & AI Status)")
        print("10) ❌ Exit\n")

        choice = get_input("Enter choice (1-10)", "10")

        if choice == "1":
            install_openclaw_ai()
        elif choice == "2":
            configure_openclaw_ai()
        elif choice == "3":
            run_openclaw_ai_daemon("start")
        elif choice == "4":
            run_openclaw_ai_daemon("stop")
        elif choice == "5":
            run_openclaw_ai_daemon("restart")
        elif choice == "6":
            launch_ai_chat()
        elif choice == "7":
            launch_ai_dashboard()
        elif choice == "8":
            run_ai_doctor()
        elif choice == "9":
            display_unified_status(interactive=True)
        elif choice == "10" or choice is None:
            print_success("Thanks for using OpenClaw TUI! Goodbye.")
            sys.exit(0)


# ==========================================
# MAIN ENTRYPOINT
# ==========================================

def main():
    if len(sys.argv) > 1:
        run_cli_mode()
    else:
        run_interactive_mode()

if __name__ == "__main__":
    main()
