# Utility logging/printing functions
def print_success(msg):
    print(f"{B_GREEN}[+] {msg}{RESET}")

def print_error(msg):
    print(f"{B_RED}[-] {msg}{RESET}", file=sys.stderr)

def print_info(msg):
    print(f"{B_CYAN}[*] {msg}{RESET}")

def print_warning(msg):
    print(f"{B_YELLOW}[!] {msg}{RESET}")

def print_header(msg):
    print(f"\n{BOLD}{B_MAGENTA}=== {msg} ==={RESET}\n")

def get_input(prompt_text, default=""):
    suffix = f" [{default}]" if default else ""
    try:
        val = input(f"{B_YELLOW}[?] {prompt_text}{suffix}: {RESET}").strip()
        return val if val else default
    except (KeyboardInterrupt, EOFError):
        print("\n")
        print_info("Operation cancelled by user.")
        return None

def clear_screen():
    # Only clear when running in a terminal
    if sys.stdout.isatty():
        os.system('cls' if os.name == 'nt' else 'clear')

